# Copy this file to .env and fill in your own keys.
# An API key is a long password that lets this kit talk to a service.
# .env is gitignored. Never put a key in any other file, and never paste one into chat.

# Prospeo = FINDER. Lists people at a company and returns verified emails.  https://prospeo.io
PROSPEO_API_KEY=

# Better Contact = FINDER, independent second opinion. Catches what Prospeo misses.  https://bettercontact.rocks
BETTERCONTACT_API_KEY=

# BounceBan = VERIFIER. Judges whether an address will land. It cannot FIND an address.
# The line is named BOUNCER_* for compatibility but holds the BounceBan key.  https://bounceban.com
BOUNCER_API_KEY=

# Optional, only for LinkedIn profile scraping in enrich-contacts (not needed for find-people):
# APIFY_API_TOKEN=
